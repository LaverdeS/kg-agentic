# Copy to .env and fill these values yourself. Never commit .env.
OPENAI_API_KEY=
NEO4J_PASSWORD=

# Local defaults
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_DATABASE=neo4j
OPENAI_MODEL=gpt-5-mini
OPENAI_SMALL_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
MODEL_MAX_OUTPUT_TOKENS=3000
GRAPHITI_MAX_TOKENS=4096
GRAPHITI_MAX_COROUTINES=4
INVESTIGATION_EVIDENCE_LIMIT=8
KG_AGENTIC_DATA_DIR=var/corpora
